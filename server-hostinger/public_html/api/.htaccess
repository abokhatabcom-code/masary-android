Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve Bearer tokens on Apache/FastCGI hosts that do not expose
  # Authorization to PHP automatically.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  RewriteRule ^v1/health/?$ v1/health.php [L,QSA]
  RewriteRule ^v1/auth/student/login/?$ v1/auth/student/login.php [L,QSA]
  RewriteRule ^v1/auth/refresh/?$ v1/auth/refresh.php [L,QSA]
  RewriteRule ^v1/auth/logout/?$ v1/auth/logout.php [L,QSA]
  RewriteRule ^v1/me/?$ v1/me.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
</IfModule>

<FilesMatch "^_.*\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|log|ini|env|jks|keystore)$">
  Require all denied
</FilesMatch>

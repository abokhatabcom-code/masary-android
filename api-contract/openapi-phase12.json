{
  "openapi": "3.1.0",
  "info": {
    "title": "Masary Android API — Phase 12 content tree",
    "version": "12.0.0",
    "description": "إضافة نماذج الوحدات والدروس وحالات التقدم الموثقة إلى استجابة صفحة المادة الحالية دون مسار جديد."
  },
  "paths": {},
  "components": {
    "responses": {},
    "schemas": {
      "SubjectLearningState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "in_progress",
              "completed",
              "locked",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SubjectLesson": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "unit_id",
          "part_number",
          "title",
          "position",
          "state",
          "preparation"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "unit_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "part_number": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/SubjectLearningState"
          },
          "preparation": {
            "$ref": "#/components/schemas/SubjectActionAvailability"
          }
        }
      },
      "SubjectUnit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "part_number",
          "title",
          "position",
          "state",
          "lessons"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "part_number": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "state": {
            "$ref": "#/components/schemas/SubjectLearningState"
          },
          "lessons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectLesson"
            }
          }
        }
      }
    }
  }
}

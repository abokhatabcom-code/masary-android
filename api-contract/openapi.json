  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Student": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "device_name"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "device_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "LogoutRequest": {
        "$ref": "#/components/schemas/RefreshRequest"
      },
      "LogoutData": {
        "type": "object",
        "required": [
          "logged_out"
        ],
        "properties": {
          "logged_out": {
            "type": "boolean"
          }
        }
      },
      "MeData": {
        "type": "object",
        "required": [
          "student"
        ],
        "properties": {
          "student": {
            "$ref": "#/components/schemas/Student"
          }
        }
      },
      "HealthData": {
        "type": "object",
        "required": [
          "service",
          "version",
          "status",
          "server_time"
        ],
        "properties": {
          "service": {
            "const": "masary-api"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "const": "ok"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HomeData": {
        "type": "object",
        "required": [
          "version",
          "generated_at",
          "student",
          "summary",
          "streak",
          "today",
          "subscription",
          "notifications",
          "continue_learning",
          "smart_guide"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "generated_at": {
            "type": "string"
          },
          "student": {
            "$ref": "#/components/schemas/HomeStudent"
          },
          "summary": {
            "$ref": "#/components/schemas/HomeSummary"
          },
          "streak": {
            "$ref": "#/components/schemas/HomeStreak"
          },
          "today": {
            "$ref": "#/components/schemas/HomeToday"
          },
          "subscription": {
            "$ref": "#/components/schemas/HomeSubscription"
          },
          "notifications": {
            "$ref": "#/components/schemas/HomeNotifications"
          },
          "continue_learning": {
            "$ref": "#/components/schemas/HomeContinueLearning"
          },
          "smart_guide": {
            "$ref": "#/components/schemas/HomeSmartGuide"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/LogoutData"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/MeData"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "HomeResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/HomeData"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "null"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "HomeStudent": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "avatar_path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "HomeSummary": {
        "type": "object",
        "required": [
          "global_xp",
          "gems",
          "level",
          "level_percent",
          "level_next_xp"
        ],
        "properties": {
          "global_xp": {
            "type": "integer"
          },
          "gems": {
            "type": "integer"
          },
          "level": {
            "type": "integer"
          },
          "level_percent": {
            "type": "integer"
          },
          "level_next_xp": {
            "type": "integer"
          }
        }
      },
      "HomeStreakGoal": {
        "type": "object",
        "required": [
          "days",
          "status",
          "is_completed",
          "remaining_days",
          "progress_percent",
          "gems",
          "shields",
          "label"
        ],
        "properties": {
          "days": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "is_completed": {
            "type": "boolean"
          },
          "remaining_days": {
            "type": "integer"
          },
          "progress_percent": {
            "type": "integer"
          },
          "gems": {
            "type": "integer"
          },
          "shields": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "HomeStreak": {
        "type": "object",
        "required": [
          "current_days",
          "best_days",
          "protection_count",
          "protection_max",
          "next_milestone",
          "checkpoint_days",
          "status",
          "message",
          "goal"
        ],
        "properties": {
          "current_days": {
            "type": "integer"

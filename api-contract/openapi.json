    "title": "Masary Android API",
    "version": "1.0.0",
    "description": "العقد المرجعي الحالي بين تطبيق Android وواجهة PHP لمسارات /api/v1 الموجودة. لا ينشئ مسارات /api/android/v1 ولا يصف Push V2 أو PWA."
  },
  "servers": [
    {
      "url": "https://development.masary.invalid/",
      "description": "Development placeholder only; inject the real URL at build time"
    },
    {
      "url": "https://staging.masary.invalid/",
      "description": "Staging placeholder only; inject the real URL at build time"
    },
    {
      "url": "https://masary.app/",
      "description": "Production"
    }
  ],

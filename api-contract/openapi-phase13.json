{
  "openapi": "3.1.0",
  "info": {
    "title": "Masary Android API — Phase 13 question session extension",
    "version": "13.6.0",
    "description": "حزمة جلسة الأسئلة وسياسة الاختبار المؤكدة من /admin/tests/، مع التصحيح العادل والمكافآت والنتيجة دون كشف مفاتيح التصحيح قبل الإنهاء."
  },
  "paths": {
    "/api/v1/student/activity/session": {
      "get": {
        "summary": "Read the authenticated student's question session package",
        "description": "يعيد حزمة العرض فقط لجلسة النشاط المملوكة للطالب. لا يغيّر حالة الجلسة ولا يعيد الإجابات الصحيحة.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/QuestionSessionPackageSuccess"
          },
          "401": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "404": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "410": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "422": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "429": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "503": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          }
        }
      }
    },
    "/api/v1/student/activity/answer": {
      "post": {
        "summary": "Submit one idempotent question answer",
        "description": "يثبت النسخة النهائية من إجابة السؤال بصورة idempotent ويعيد درجة عادلة من 0 إلى 1؛ مفاتيح التصحيح تبقى على الخادم.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/QuestionAnswerSuccess"
          },
          "401": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "404": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "409": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "410": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "422": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "429": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "503": {
            "$ref": "#/components/responses/QuestionAnswerError"
          }
        }
      }
    },
    "/api/v1/student/activity/finish": {
      "post": {
        "summary": "Finish one authenticated question session idempotently",
        "description": "يغلق الجلسة idempotently ويطبق Snapshot إعدادات الأدمن: النجاح وXP والقلوب والتقدم والوقت وتفاصيل المراجعة المسموح بها.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionFinishRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/QuestionFinishSuccess"
          },
          "401": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "404": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "409": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "410": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "422": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "429": {
            "$ref": "#/components/responses/QuestionFinishError"
          },
          "503": {
            "$ref": "#/components/responses/QuestionFinishError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "QuestionSessionPackageSuccess": {
        "description": "Owned question session package envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QuestionSessionPackageResponse"
            }
          }
        }
      },
      "QuestionSessionPackageError": {
        "description": "API error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "QuestionAnswerSuccess": {
        "description": "Confirmed answer result envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QuestionAnswerResponse"
            }
          }
        }
      },
      "QuestionAnswerError": {
        "description": "API error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "QuestionFinishSuccess": {
        "description": "Confirmed immutable question session result",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QuestionFinishResponse"
            }
          }
        }
      },
      "QuestionFinishError": {
        "description": "API error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "QuestionSessionDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "expires_at",
          "started_at",
          "started_at_epoch_seconds",
          "subject_version_id",
          "unit_id",
          "lesson_id",
          "activity_type",
          "activity_mode",
          "source",
          "guide_step_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          },
          "subject_version_id": {
            "type": "integer",
            "minimum": 1
          },
          "unit_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "lesson_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "activity_type": {
            "type": "string",
            "enum": [
              "lesson_practice",
              "choose_test",
              "true_false_test",
              "connect_test",
              "fill_test",
              "speed_test",
              "review",
              "smart_review"
            ]
          },
          "activity_mode": {
            "type": "string",
            "enum": [
              "learn",
              "practice",
              "review",
              "test",
              "speed"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "started_at_epoch_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "subject",
              "unit",
              "lesson",
              "review",
              "home_guide",
              "guide"
            ]
          },
          "guide_step_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "QuestionSessionProgress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_index",
          "total_questions"
        ],
        "properties": {
          "current_index": {
            "type": "integer",
            "minimum": 0
          },
          "total_questions": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "QuestionOption": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionOptionsPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "options"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          }
        }
      },
      "QuestionFillPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_mode",
          "blanks_count"
        ],
        "properties": {
          "input_mode": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "blanks_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        }
      },
      "QuestionConnectItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionConnectPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_items",
          "right_items"
        ],
        "properties": {
          "left_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectItem"
            }
          },
          "right_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectItem"
            }
          }
        }
      },
      "QuestionSessionQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "prompt",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "type": {
            "type": "string",
            "enum": [
              "choose",
              "truefalse",
              "connect",
              "fill",
              "direct",
              "speed"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionOptionsPayload"
              },
              {
                "$ref": "#/components/schemas/QuestionTrueFalsePayload"
              },
              {
                "$ref": "#/components/schemas/QuestionFillPayload"
              },
              {
                "$ref": "#/components/schemas/QuestionDirectPayload"
              },
              {
                "$ref": "#/components/schemas/QuestionConnectPayload"
              }
            ]
          }
        }
      },
      "QuestionSessionPackageData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "generated_at",
          "session",
          "progress",
          "policy",
          "questions"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "generated_at": {
            "type": "string",
            "minLength": 1
          },
          "session": {
            "$ref": "#/components/schemas/QuestionSessionDescriptor"
          },
          "progress": {
            "$ref": "#/components/schemas/QuestionSessionProgress"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionSessionQuestion"
            }
          },
          "policy": {
            "$ref": "#/components/schemas/QuestionSessionPolicy"
          }
        }
      },
      "QuestionSessionPackageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/QuestionSessionPackageData"
          },
          "error": {
            "type": "null"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionChoiceAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "option_id"
        ],
        "properties": {
          "kind": {
            "const": "choice"
          },
          "option_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "reason_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 16,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "QuestionTextAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "QuestionConnectionAnswerPair": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_id",
          "right_id"
        ],
        "properties": {
          "left_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "right_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          }
        }
      },
      "QuestionConnectionsAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "pairs"
        ],
        "properties": {
          "kind": {
            "const": "connections"
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectionAnswerPair"
            }
          }
        }
      },
      "QuestionAnswerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "question_id",
          "answer"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "question_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionChoiceAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionTextAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionFillAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionConnectionsAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionSkipAnswer"
              }
            ]
          }
        }
      },
      "QuestionAnswerProgress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answered",
          "total_questions",
          "all_answered"
        ],
        "properties": {
          "answered": {
            "type": "integer",
            "minimum": 0
          },
          "total_questions": {
            "type": "integer",
            "minimum": 1
          },
          "all_answered": {
            "type": "boolean"
          }
        }
      },
      "QuestionAnswerResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "question_id",
          "accepted",
          "correct",
          "score",
          "replayed",
          "progress"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "question_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "accepted": {
            "const": true
          },
          "correct": {
            "type": "boolean"
          },
          "replayed": {
            "type": "boolean"
          },
          "progress": {
            "$ref": "#/components/schemas/QuestionAnswerProgress"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "QuestionAnswerResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/QuestionAnswerResult"
          },
          "error": {
            "type": "null"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionFinishRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "active_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "QuestionSessionScore": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "correct_answers",
          "partial_answers",
          "incorrect_answers",
          "wrong_answers",
          "answered_questions",
          "total_questions",
          "score_points",
          "score_percent_exact",
          "score_percent",
          "passed",
          "pass_percent",
          "xp_earned",
          "hearts_spent",
          "timed_out",
          "duration_seconds",
          "attempt_id"
        ],
        "properties": {
          "correct_answers": {
            "type": "integer",
            "minimum": 0
          },
          "partial_answers": {
            "type": "integer",
            "minimum": 0
          },
          "incorrect_answers": {
            "type": "integer",
            "minimum": 0
          },
          "wrong_answers": {
            "type": "integer",
            "minimum": 0
          },
          "answered_questions": {
            "type": "integer",
            "minimum": 0
          },
          "total_questions": {
            "type": "integer",
            "minimum": 1
          },
          "score_points": {
            "type": "number",
            "minimum": 0
          },
          "score_percent_exact": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score_percent": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "passed": {
            "type": "boolean"
          },
          "pass_percent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "xp_earned": {
            "type": "number",
            "minimum": 0
          },
          "hearts_spent": {
            "type": "integer",
            "minimum": 0
          },
          "timed_out": {
            "type": "boolean"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "QuestionConfirmedDelta": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "available",
          "reason",
          "profile",
          "subjects"
        ],
        "properties": {
          "available": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionConfirmedProfileDelta"
              },
              {
                "type": "null"
              }
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConfirmedSubjectDelta"
            }
          },
          "student_id": {
            "type": "string",
            "minLength": 1
          },
          "server_version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmed_at_epoch_millis": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "QuestionFinishResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "status",
          "completed_at",
          "replayed",
          "result",
          "policy",
          "review",
          "confirmed_delta"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "status": {
            "const": "completed"
          },
          "completed_at": {
            "type": "string",
            "minLength": 1
          },
          "replayed": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/QuestionSessionScore"
          },
          "confirmed_delta": {
            "$ref": "#/components/schemas/QuestionConfirmedDelta"
          },
          "policy": {
            "$ref": "#/components/schemas/QuestionSessionPolicy"
          },
          "review": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionReviewItem"
            }
          }
        }
      },
      "QuestionFinishResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/QuestionFinishResult"
          },
          "error": {
            "type": "null"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionConfirmedProfileDelta": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "global_xp": {
            "type": "integer",
            "minimum": 0
          },
          "gems": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "level_progress_percent": {
            "type": "integer",
            "minimum": 0
          },
          "level_next_xp": {
            "type": "integer",
            "minimum": 0
          },
          "today_xp": {
            "type": "integer",
            "minimum": 0
          },
          "today_seconds": {

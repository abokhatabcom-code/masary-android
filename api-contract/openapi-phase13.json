{
  "openapi": "3.1.0",
  "info": {
    "title": "Masary Android API — Phase 13 question session extension",
    "version": "13.0.0",
    "description": "حزمة أسئلة جلسة النشاط المملوكة للطالب دون كشف مفاتيح الإجابات الصحيحة."
  },
  "paths": {
    "/api/v1/student/activity/session": {
      "get": {
        "summary": "Read the authenticated student's question session package",
        "description": "يعيد حزمة العرض فقط لجلسة النشاط المملوكة للطالب. لا يغيّر حالة الجلسة ولا يعيد الإجابات الصحيحة.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/QuestionSessionPackageSuccess"
          },
          "401": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "404": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "410": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "422": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "429": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          },
          "503": {
            "$ref": "#/components/responses/QuestionSessionPackageError"
          }
        }
      }
    },
    "/api/v1/student/activity/answer": {
      "post": {
        "summary": "Submit one idempotent question answer",
        "description": "يثبت إجابة واحدة لجلسة الطالب، ويعيد نتيجة التصحيح المؤكدة دون منح نقاط أو مستوى محليًا.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/QuestionAnswerSuccess"
          },
          "401": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "404": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "409": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "410": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "422": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "429": {
            "$ref": "#/components/responses/QuestionAnswerError"
          },
          "503": {
            "$ref": "#/components/responses/QuestionAnswerError"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "QuestionSessionPackageSuccess": {
        "description": "Owned question session package envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QuestionSessionPackageResponse"
            }
          }
        }
      },
      "QuestionSessionPackageError": {
        "description": "API error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "QuestionAnswerSuccess": {
        "description": "Confirmed answer result envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QuestionAnswerResponse"
            }
          }
        }
      },
      "QuestionAnswerError": {
        "description": "API error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "QuestionSessionDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "expires_at",
          "subject_version_id",
          "unit_id",
          "lesson_id",
          "activity_type",
          "activity_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          },
          "subject_version_id": {
            "type": "integer",
            "minimum": 1
          },
          "unit_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "lesson_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "activity_type": {
            "type": "string",
            "enum": [
              "choose_test",
              "true_false_test",
              "connect_test",
              "fill_test",
              "speed_test"
            ]
          },
          "activity_mode": {
            "type": "string",
            "enum": [
              "practice",
              "speed"
            ]
          }
        }
      },
      "QuestionSessionProgress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current_index",
          "total_questions"
        ],
        "properties": {
          "current_index": {
            "type": "integer",
            "minimum": 0
          },
          "total_questions": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "QuestionOption": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionOptionsPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "options"
        ],
        "properties": {
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          }
        }
      },
      "QuestionFillPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_mode"
        ],
        "properties": {
          "input_mode": {
            "type": "string",
            "enum": [
              "text"
            ]
          }
        }
      },
      "QuestionConnectItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionConnectPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_items",
          "right_items"
        ],
        "properties": {
          "left_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectItem"
            }
          },
          "right_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectItem"
            }
          }
        }
      },
      "QuestionSessionQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "prompt",
          "payload"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 16
          },
          "type": {
            "type": "string",
            "enum": [
              "choose",
              "truefalse",
              "connect",
              "fill",
              "speed"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionOptionsPayload"
              },
              {
                "$ref": "#/components/schemas/QuestionFillPayload"
              },
              {
                "$ref": "#/components/schemas/QuestionConnectPayload"
              }
            ]
          }
        }
      },
      "QuestionSessionPackageData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "generated_at",
          "session",
          "progress",
          "questions"
        ],
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1
          },
          "generated_at": {
            "type": "string",
            "minLength": 1
          },
          "session": {
            "$ref": "#/components/schemas/QuestionSessionDescriptor"
          },
          "progress": {
            "$ref": "#/components/schemas/QuestionSessionProgress"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionSessionQuestion"
            }
          }
        }
      },
      "QuestionSessionPackageResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/QuestionSessionPackageData"
          },
          "error": {
            "type": "null"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "QuestionChoiceAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "option_id"
        ],
        "properties": {
          "kind": {
            "const": "choice"
          },
          "option_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          }
        }
      },
      "QuestionTextAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "QuestionConnectionAnswerPair": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left_id",
          "right_id"
        ],
        "properties": {
          "left_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "right_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          }
        }
      },
      "QuestionConnectionsAnswer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "pairs"
        ],
        "properties": {
          "kind": {
            "const": "connections"
          },
          "pairs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionConnectionAnswerPair"
            }
          }
        }
      },
      "QuestionAnswerRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "question_id",
          "answer"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "question_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "answer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionChoiceAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionTextAnswer"
              },
              {
                "$ref": "#/components/schemas/QuestionConnectionsAnswer"
              }
            ]
          }
        }
      },
      "QuestionAnswerProgress": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answered",
          "total_questions",
          "all_answered"
        ],
        "properties": {
          "answered": {
            "type": "integer",
            "minimum": 0
          },
          "total_questions": {
            "type": "integer",
            "minimum": 1
          },
          "all_answered": {
            "type": "boolean"
          }
        }
      },
      "QuestionAnswerResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "question_id",
          "accepted",
          "correct",
          "replayed",
          "progress"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "question_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 64
          },
          "accepted": {
            "const": true
          },
          "correct": {
            "type": "boolean"
          },
          "replayed": {
            "type": "boolean"
          },
          "progress": {
            "$ref": "#/components/schemas/QuestionAnswerProgress"
          }
        }
      },
      "QuestionAnswerResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "data",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/QuestionAnswerResult"
          },
          "error": {
            "type": "null"
          },
          "request_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
